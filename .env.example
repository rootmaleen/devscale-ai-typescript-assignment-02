# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
# API key for your OpenAI-compatible provider.
OPENAI_API_KEY="your-api-key"

# Optional custom provider endpoint. The model is configured in src/llm/models.ts.
# OPENAI_BASE_URL="https://your-provider.example/v1"