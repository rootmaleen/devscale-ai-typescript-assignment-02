model Job {
  id String @id @default(uuid())
  diet String
  budget String
  status String
  createdAt DateTime @default(now())

  results JobResult[]
  outboxMessages OutboxMessage[]
}

model JobResult {
  id String @id @default(uuid())
  name String
  description String
  ingredients String
  instructions String
  jobId String
  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model OutboxMessage {
  id String @id @default(uuid())
  jobId String
  type String
  payload String
  status String
  createdAt DateTime @default(now())
  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
}