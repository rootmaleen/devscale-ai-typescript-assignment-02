{
  "name": "hono-prisma",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker:dev": "tsx watch src/worker/worker.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "contract:emit": "prisma contract emit",
    "db:init": "pnpm run contract:emit && pnpm exec prisma db init && pnpm exec prisma db verify",
    "db:update": "pnpm run contract:emit && pnpm exec prisma db update --dry-run && pnpm exec prisma db update"
  },
  "dependencies": {
    "@anvia/core": "^1.2.2",
    "@anvia/openai": "^1.1.3",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.1",
    "@js-temporal/polyfill": "^0.5.1",
    "@prisma/orm-postgres": "8.0.0-rc.9",
    "bullmq": "^6.3.4",
    "dotenv": "^17.4.2",
    "hono": "^4.13.7",
    "ioredis": "^6.0.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@prisma/cli-engine": "0.3.0",
    "@types/node": "^26.1.1",
    "prisma": "8.0.0-rc.10",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}